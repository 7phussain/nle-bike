# ElectroRide Pro - Environment Configuration
# Copy this file to .env and modify as needed

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true

# Database Configuration
DATABASE_PATH=data/inventory.db

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/inventory_sync.log

# Inventory Sync Configuration
SYNC_INTERVAL_MINUTES=30
SOURCE_SITE_URL=https://engwe.com/
MAX_PRODUCTS_PER_SYNC=100
RETRY_ATTEMPTS=3
RETRY_DELAY_SECONDS=5

# Application Configuration
APP_NAME=ElectroRide Pro
APP_VERSION=1.0.0
APP_DESCRIPTION=Modern Drop Shipping E-commerce Site

# Security Configuration
SECRET_KEY=your-secret-key-here
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# External Services
GOOGLE_ANALYTICS_ID=
FACEBOOK_PIXEL_ID=

# Payment Configuration (for future use)
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
PAYPAL_CLIENT_ID=

# CDN Configuration
CDN_URL=
IMAGE_CDN_URL=

# Cache Configuration
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=3600

# Performance Configuration
MAX_WORKERS=4
TIMEOUT_SECONDS=30
RATE_LIMIT_PER_MINUTE=100